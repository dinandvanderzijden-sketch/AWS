# Kopieer naar terraform.tfvars en vul aan. Nooit committen als er geheimen
# in staan — gebruik voor de pipeline TF_VAR_* env vars / GitHub secrets.

aws_region   = "eu-west-1"
project_name = "innovatech-webplatform"
environment  = "production"

admin_cidr = "203.0.113.10/32" # jouw eigen IP — nooit 0.0.0.0/0 in productie

container_image = "nginx:1.27-alpine" # of jouw eigen ECR-repo:tag

github_org  = "jouw-github-org"
github_repo = "jouw-repo-naam"
# github_runner_token: NIET hier zetten, altijd als -var meegeven.

key_pair_name = null
